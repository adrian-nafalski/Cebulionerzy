<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ChangeRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="ChangeDot">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginEnd">9dp</item>
        <item name="android:background">@drawable/rounded_card</item>
        <item name="android:backgroundTint">@color/orange</item>
    </style>

    <style name="ChangeText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/gluten_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
