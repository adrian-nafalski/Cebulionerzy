<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="12dp"
    tools:context=".mainFragment.LastChangesFragment">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/rounded_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gluten_bold"
            android:gravity="center"
            android:text="Wersja 1.0"
            android:textColor="@color/black"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/gluten_regular"
            android:gravity="center"
            android:text="Pierwsze wydanie gry"
            android:textColor="#555555"
            android:textSize="13sp" />

        <View
            android:layout_width="44dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@color/orange" />

        <LinearLayout style="@style/ChangeRow">
            <View style="@style/ChangeDot" />
            <TextView
                style="@style/ChangeText"
                android:text="12 pytań i wygrana do miliona cebulionów" />
        </LinearLayout>

        <LinearLayout style="@style/ChangeRow">
            <View style="@style/ChangeDot" />
            <TextView
                style="@style/ChangeText"
                android:text="Koła ratunkowe: Naród, Połóweczka i Telefon do Pjotera" />
        </LinearLayout>

        <LinearLayout style="@style/ChangeRow">
            <View style="@style/ChangeDot" />
            <TextView
                style="@style/ChangeText"
                android:text="Telewizor z kanałami" />
        </LinearLayout>

        <LinearLayout style="@style/ChangeRow">
            <View style="@style/ChangeDot" />
            <TextView
                style="@style/ChangeText"
                android:text="Tablica nagród" />
        </LinearLayout>

        <LinearLayout style="@style/ChangeRow">
            <View style="@style/ChangeDot" />
            <TextView
                style="@style/ChangeText"
                android:text="Muzyka z opcją wyłączenia" />
        </LinearLayout>

        <TextView
            android:id="@+id/close_button"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_card"
            android:backgroundTint="@color/orange"
            android:fontFamily="@font/gluten_bold"
            android:gravity="center"
            android:text="Zamknij"
            android:textColor="@color/black"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/last_changes_title"
        android:layout_width="160dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/rounded_card"
        android:elevation="8dp"
        android:fontFamily="@font/gluten_regular"
        android:gravity="center"
        android:text="Ostatnie zmiany"
        android:textColor="@color/black"
        android:textSize="15sp" />
</FrameLayout>
